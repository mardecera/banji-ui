{
	"name": "banji-ui",
	"version": "1.0.3",
	"private": false,
	"type": "module",
	"description": "Libreria de componentes React con landing y Storybook.",
	"keywords": ["react", "components", "vite", "storybook", "library"],
	"license": "MIT",
	"sideEffects": ["*.css"],
	"main": "./dist-lib/index.cjs",
	"module": "./dist-lib/index.js",
	"types": "./dist-lib/index.d.ts",
	"exports": {
		".": {
			"types": "./dist-lib/index.d.ts",
			"import": "./dist-lib/index.js",
			"require": "./dist-lib/index.cjs"
		},
		"./style.css": "./dist-lib/style.css"
	},
	"files": ["dist-lib"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "concurrently -k -n WEB,STORYBOOK -c cyan,magenta \"vite\" \"storybook dev -p 6006 --no-open\"",
		"dev:web": "vite",
		"start": "vite preview --host",
		"build": "pnpm clean:web && pnpm build:lib && pnpm build:web && pnpm build:storybook:web",
		"build:web": "vite build",
		"preview": "vite preview",
		"pack:lib": "pnpm build:lib && pnpm pack",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"clean:web": "rimraf dist",
		"build:lib": "pnpm clean:lib && tsc -p tsconfig.lib.json && vite build --mode lib",
		"clean:lib": "rimraf dist-lib",
		"prepublishOnly": "pnpm test && pnpm build:lib",
		"storybook": "storybook dev -p 6006",
		"build:storybook:web": "storybook build -o dist/storybook --disable-telemetry",
		"build:storybook": "storybook build --disable-telemetry"
	},
	"peerDependencies": {
		"react": "^18.3.0 || ^19.0.0",
		"react-dom": "^18.3.0 || ^19.0.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@storybook/addon-essentials": "8.6.18",
		"@storybook/addon-interactions": "8.6.18",
		"@storybook/react": "8.6.18",
		"@storybook/react-vite": "8.6.18",
		"@tailwindcss/vite": "^4.1.7",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^22.15.18",
		"@types/react": "^18.3.21",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^4.4.1",
		"concurrently": "^9.1.2",
		"jsdom": "^25.0.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"rimraf": "^6.0.1",
		"storybook": "8.6.18",
		"tailwindcss": "^4.1.7",
		"typescript": "^5.8.3",
		"vite": "^5.4.18",
		"vite-plugin-dts": "^4.5.3",
		"vitest": "^2.1.9",
		"banji-ui": "file:banji-ui-1.0.3.tgz",
		"prism-react-renderer": "^2.4.1",
		"react-router-dom": "^7.14.2"
	}
}
